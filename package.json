{
  "name": "laundry-advisor-card",
  "version": "0.2.0",
  "description": "Lovelace card for the Home Assistant Laundry Advisor / Wäschewetter blueprint",
  "type": "module",
  "main": "dist/laundry-advisor-card.js",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "lovelace-custom-card",
    "hacs",
    "laundry",
    "weather"
